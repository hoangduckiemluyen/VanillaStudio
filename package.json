{
  "name": "vanillastudio",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bundle:css": "npx esbuild ./Application/Sources/Styles/EntryPoint.css --bundle --minify --outfile=./Application/Build/Style.min.css",
    "bundle:ts": "npx esbuild ./Application/Sources/Scripts/EntryPoint.ts --bundle --minify --target=es2020 --sourcemap --outfile=./Application/Build/Script.min.js",
    "watch:bundle:css": "npx esbuild ./Application/Sources/Styles/EntryPoint.css --bundle --minify --outfile=./Application/Build/Style.min.css --watch",
    "watch:bundle:ts": "npx esbuild ./Application/Sources/Scripts/EntryPoint.ts  --bundle --minify --target=es2020 --sourcemap --outfile=./Application/Build/Script.min.js --watch",
    "scss:watch": "sass --load-path=. --watch Application/Sources//main.scss css/style.css",
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": {
    "name": "Hoang Duc Kiem Luyen (Fedora Z)",
    "email": "hoangduckiemluyen@gmail.com",
    "url": "https://github.com/hoangduckiemluyen/"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "sass": "^1.108.2",
    "typescript": "^7.0.2"
  }
}
